amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

// Keep the amends/import version in lockstep with the `hk` version in mise.toml,
// and only pin a version mise can actually install (`mise ls-remote hk`).
//
// Two mappings keep the mise tasks single-purpose:
//   mise run format -> the `fix` hook   -> `formatters` (write mode)
//   mise run lint   -> the `check` hook -> `linters` (read-only rule checks)
// The `pre-commit` hook runs BOTH, so every commit stays formatted and clean.
//
// Step keys use a uniform `Language(Action)  [[builtins.tool]]` scheme,
// column-aligned on the bracket tag, so hk's per-run output reads consistently.

// Formatters — rewrite files into canonical form.
local formatters = new Mapping<String, Step> {
  // rumdl owns Markdown — one tool for both lint and format. The format step runs
  // `rumdl fmt` (applies fixes, formatter exit codes — won't fail the commit on
  // leftover lint). yamlfmt owns YAML, taplo TOML.
  // `check_diff = null` on rumdl_format and taplo_format: hk applies a builtin's
  // check_diff patch instead of running `fix`, and their diffs don't apply cleanly.
  // Nulling it leaves no read-mode command, so each step supplies its own `check`.
  ["Markdown(Format)  [[builtins.rumdl_format]]"] = (Builtins.rumdl_format) {
    check = "rumdl fmt --check {{ files }}"
    check_diff = null
  }

  ["YAML(Format)      [[builtins.yamlfmt]]"] = Builtins.yamlfmt

  ["TOML(Format)      [[builtins.taplo_format]]"] = (Builtins.taplo_format) {
    check = "taplo format --check {{ files }}"
    check_diff = null
  }

  ["Pkl(Format)       [[builtins.pkl_format]]"] = Builtins.pkl_format

  ["Shell(Format)     [[builtins.shfmt]]"] = Builtins.shfmt

  ["TS(Format)        [[builtins.biome]]"] = (Builtins.biome) {
    glob =
      List(
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.jsonc",
      )
    check = "biome format --no-errors-on-unmatched {{ files }}"
    fix = "biome format --write --no-errors-on-unmatched {{ files }}"
  }
}

// Linters — check rules without rewriting.
local linters = new Mapping<String, Step> {
  ["Shell(Lint)       [[builtins.shellcheck]]"] = Builtins.shellcheck

  // Same tool, read-only lint: `rumdl check` reports violations (exit 1);
  // pre-commit autofixes via the builtin's `rumdl check --fix`. Config: .rumdl.toml.
  ["Markdown(Lint)    [[builtins.rumdl]]"] = (Builtins.rumdl) {
    check_diff = null
    check_after_diff = false
  }

  ["TOML(Lint)        [[builtins.taplo]]"] = Builtins.taplo

  // pkl lints by evaluating the file (`pkl eval`), which resolves the remote
  // amends/import package (cached after first run). Exclude template/fixture
  // .pkl files you don't want evaluated.
  ["Pkl(Lint)         [[builtins.pkl]]"] = Builtins.pkl

  ["TS(Lint)          [[builtins.biome]]"] = (Builtins.biome) {
    glob =
      List(
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.jsonc",
      )
    check = "biome check --formatter-enabled=false --no-errors-on-unmatched {{ files }}"
    fix = "biome check --formatter-enabled=false --write --no-errors-on-unmatched {{ files }}"
  }

  ["TS(Type)          [[builtins.tsc]]"] = (Builtins.tsc) {
    check = "bunx tsc --noEmit -p {{workspace_indicator}}"
  }

  // Project-specific steps go here. Glob-scope so a step only runs when relevant
  // files change; omit {{ files }} to run a command once (e.g. a test suite):
  // ["Custom(Test)     [[my-tests]]"] = new Step {
  //   glob = List("src/**/*.py", "tests/**/*.py")
  //   check = "uv run pytest"
  // }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }

  // `mise run format` — formatters only, in write mode.
  ["fix"] {
    fix = true
    steps = formatters
  }

  // `mise run lint` — linters only (rule checks); read-only.
  ["check"] {
    steps = linters
  }

  // `mise run test` on push, when the `test` task is chosen. The glob comes from each
  // loaded language reference — union them in a multi-language repo.
  // ["pre-push"] {
  //   steps = new Mapping<String, Step> {
  //     ["Project(Test)     [[tasks.test]]"] = new Step {
  //       glob = List("**/*.go", "go.mod", "go.sum")
  //       check = "mise run test"
  //     }
  //   }
  // }
}
