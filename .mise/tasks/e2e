#!/usr/bin/env bash
#MISE description="Build the extension and run the browser smoke suite against it in Chromium and Firefox"
#USAGE arg "[browser]" help="Only run the suite in this browser" { choices "chromium" "firefox"; }

set -euo pipefail

browsers=(chromium firefox)
[ -n "${usage_browser:-}" ] && browsers=("$usage_browser")

bun run build
bunx --no-install playwright install --no-shell "${browsers[@]}"
bunx --no-install playwright test "${browsers[@]/#/--project=}"
