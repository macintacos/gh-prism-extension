#!/usr/bin/env bash
#MISE description="Build the extension and open it in the dedicated dev Chrome and Firefox profiles, reloading on change"
#USAGE flag "-y --yes" help="Close a Chrome or Firefox that already holds its dev profile without asking"

set -euo pipefail

# Keep in sync with chromeProfile and firefoxProfile in wxt.config.ts.
chrome_profile="$HOME/.local/share/gh-prism-extension/chrome-profile"
firefox_profile="$HOME/.local/share/gh-prism-extension/firefox-profile"

# The browser process launched with <launch-arg><profile>, if any. Chrome's helpers carry --type=,
# Firefox's -contentproc or plugin-container.
profile_holder() {
	local listing rc=0
	listing=$(pgrep -lf -- "$1$2( |\$)") || rc=$?
	# pgrep exits 1 when nothing matches.
	((rc <= 1)) || return "$rc"
	awk 'NF && !/ --type=| -contentproc|plugin-container/ { print $1; exit }' <<<"$listing"
}

# free_profile <Browser> <launch-arg> <profile>
# A second Chrome on a held profile hands off to the first and exits, which web-ext reports only as
# "CDP connection closed before response to Extensions.loadUnpacked". A second Firefox refuses to start.
free_profile() {
	local browser=$1 pid answer
	pid=$(profile_holder "$2" "$3")
	[[ -n $pid ]] || return 0

	printf '%s\n' "! The dev profile is already open in $browser (pid $pid), and $browser won't open a profile twice." >&2
	echo "  It's another \`mise run dev\`, or a dev window an earlier run left open." >&2
	if [[ ${usage_yes:-false} != true ]]; then
		if [[ ! -t 0 ]]; then
			echo "Quit that $browser and run \`mise run dev\` again, or run \`mise run dev --yes\` to close it." >&2
			exit 1
		fi
		read -r -p "Close that $browser and continue? [y/N] " answer || exit 1
		[[ $answer == [yY]* ]] || exit 1
	fi

	kill "$pid" || :
	for _ in {1..50}; do
		if ! kill -0 "$pid" 2>/dev/null; then
			printf '%s\n' "Closed $browser (pid $pid)." >&2
			return 0
		fi
		sleep 0.2
	done
	printf '%s\n' "$browser (pid $pid) is still running. Quit it, then run \`mise run dev\` again." >&2
	exit 1
}

stop_firefox() {
	kill "$firefox_dev" 2>/dev/null || :
	local pid
	pid=$(profile_holder "-profile " "$firefox_profile") || return 0
	[[ -z $pid ]] || kill "$pid" 2>/dev/null || :
}

main() {
	free_profile Chrome --user-data-dir= "$chrome_profile"
	free_profile Firefox "-profile " "$firefox_profile"
	# A fresh clone may skip setup; postinstall (wxt prepare) generates .wxt/.
	bun install
	# Run wxt itself, not through bun run, so $! is the process the trap must stop.
	node_modules/.bin/wxt -b firefox --port 3001 &
	firefox_dev=$!
	trap stop_firefox EXIT
	bun run dev
}

main "$@"
